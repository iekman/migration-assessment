    "get_security_rules": {
      "__byArg__": "type",
      "values": {
        "firestore": {
          "source": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{db}/documents {\n    function isOwner(uid) { return request.auth.uid == uid; }\n    function hasRole(role) { return role in get(/databases/$(db)/documents/users/$(request.auth.uid)).data.roles; }\n\n    match /accounts/{accountId} {\n      allow read: if get(/databases/$(db)/documents/accounts/$(accountId)).data.workspaceId == request.auth.token.workspaceId;\n      allow write: if hasRole('admin');\n      match /teams/{teamId} {\n        allow read: if true;\n        match /members/{memberId} {\n          allow read, write: if isOwner(memberId);\n        }\n      }\n    }\n    match /deals/{dealId} {\n      allow read, write: if exists(/databases/$(db)/documents/accounts/$(resource.data.accountId));\n    }\n    match /contacts/{contactId} {\n      allow read, write: if isOwner(resource.data.ownerId);\n      match /notes/{noteId} {\n        allow read, write: if isOwner(resource.data.authorId);\n      }\n    }\n    match /activities/{activityId} {\n      allow read: if true;\n      allow write: if request.auth != null;\n    }\n  }\n}\n"
        },
        "storage": { "source": "rules_version = '2';\nservice firebase.storage {\n  match /b/{bucket}/o {\n    match /invoices/{accountId}/{fileName} {\n      allow read: if request.auth != null;\n      allow write: if false;\n    }\n  }\n}\n" },
        "database": { "source": "{\n  \"rules\": {\n    \"presence\": { \".read\": true, \".write\": \"auth != null\" },\n    \"legacy\": { \".read\": true, \".write\": false }\n  }\n}\n" }
      }
    },
