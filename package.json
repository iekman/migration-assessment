{
  "name": "fb-to-serverpod-assessor",
  "version": "0.1.0",
  "description": "Standalone CLI that connects to a Firebase project's MCP server and produces a migration-complexity report for moving the backend to Serverpod.",
  "type": "module",
  "private": true,
  "bin": {
    "fb-to-serverpod-assessor": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "tsx src/cli.ts",
    "mock": "tsx src/cli.ts --mock --config fixtures/mock-project.config.json",
    "typecheck": "tsc -p . --noEmit",
    "test": "npm run build && node scripts/test-real-world.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
